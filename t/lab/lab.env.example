# Copie para t/lab/lab.env e preencha somente no workstation do operador.
# Os valores reais do laboratório ficam fora do repositório público.

LAB_SSH_CONFIG="/caminho/para/pve-lab/ssh_config"
LAB_NODE1="REPLACE_WITH_LAB_NODE_1"
LAB_NODE2="REPLACE_WITH_LAB_NODE_2"
LAB_NODE3="REPLACE_WITH_LAB_NODE_3"
LAB_GATEWAY_NODE="REPLACE_WITH_GATEWAY_PVE_NODE"
LAB_CLUSTER_NAME="REPLACE_WITH_LAB_CLUSTER"

LAB_API_SCHEME="https"
LAB_API_PORT="8006"
LAB_API_CA_FILE="/caminho/remoto/para/ca-do-pveproxy.pem"
LAB_ALLOWED_TOKEN_ID="REPLACE_WITH_ALLOWED_TOKEN_ID"
LAB_ALLOWED_TOKEN_SECRET_FILE="/caminho/remoto/para/allowed-token.secret"
# O usuário do token permitido precisa de uma role customizada com Sys.Audit
# + Sys.Modify em /; no PVE 9, PVESysAdmin não inclui Sys.Modify. O usuário
# do token proibido não deve ter permissões para /.
LAB_FORBIDDEN_TOKEN_ID="REPLACE_WITH_FORBIDDEN_TOKEN_ID"
LAB_FORBIDDEN_TOKEN_SECRET_FILE="/caminho/remoto/para/forbidden-token.secret"

LAB_BRIDGE="REPLACE_WITH_LAB_BRIDGE"
LAB_RESTORE_VLAN="REPLACE_WITH_RESTORE_VLAN"
LAB_SECOND_VLAN="REPLACE_WITH_SECOND_VLAN"
LAB_RESTORE_GATEWAY_IP="REPLACE_WITH_RESTORE_GATEWAY_IP"
LAB_RESTORE_VM_IP="REPLACE_WITH_RESTORE_VM_IP"
LAB_RESTORE_PREFIX="24"
LAB_RESTORE_HOURS="1"

LAB_GATEWAY_VMID="REPLACE_WITH_GATEWAY_VMID"
LAB_GATEWAY_STORAGE="REPLACE_WITH_GATEWAY_STORAGE"
# storage com content "snippets" para o vendor-data do cloud-init (instala o qemu-guest-agent)
LAB_GATEWAY_SNIPPET_STORAGE="local"
LAB_GATEWAY_MARKER="mm-pve-tools lab gateway marker"
LAB_GATEWAY_TRUNK_IFACE="REPLACE_WITH_GATEWAY_TRUNK_IFACE"
LAB_GATEWAY_IMAGE_URL="https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-amd64.qcow2"
LAB_GATEWAY_SHA512_URL="https://cloud.debian.org/images/cloud/trixie/latest/SHA512SUMS"
LAB_GATEWAY_IMAGE_FILE="/var/lib/vz/template/iso/debian-13-genericcloud-amd64.qcow2"
LAB_GATEWAY_KEY_FILE="/caminho/local/para/id_ed25519.pub"
LAB_GATEWAY_TMP_PACKAGE="/tmp/mm-gw-restore.deb"
LAB_PBS_IP="REPLACE_WITH_PBS_IP"
LAB_PBS_USER="gw-restore@pbs!gateway"
LAB_PBS_TOKEN_FILE="/caminho/local/para/pbs-token-gateway"
LAB_PBS_FINGERPRINT_FILE="/caminho/local/para/pbs-fingerprint"
LAB_PBS_STORAGE="REPLACE_WITH_PBS_STORAGE"
LAB_PBS_DATASTORE="REPLACE_WITH_PBS_DATASTORE"
LAB_PBS_REPO_URL="http://download.proxmox.com/debian/pbs-client"
LAB_PBS_KEY_URL="https://enterprise.proxmox.com/debian/proxmox-archive-keyring-trixie.gpg"
LAB_PBS_KEY_SHA256="136673be77aba35dcce385b28737689ad64fd785a797e57897589aed08db6e45"
LAB_MASTERMIND_APT="https://apt.mastermindti.cloud/debian"
LAB_MASTERMIND_KEY_URL="https://apt.mastermindti.cloud/mastermind-archive.gpg"
LAB_MASTERMIND_ORIGIN="MasterMind"

LAB_WINLAB_VMID="REPLACE_WITH_WINLAB_VMID"
LAB_WINLAB_NAME="REPLACE_WITH_WINLAB_NAME"
LAB_WINLAB_NODE="REPLACE_WITH_WINLAB_NODE"
LAB_WINLAB_NIC_KEY="net1"
LAB_WINLAB_NIC_MAC="REPLACE_WITH_UNALLOCATED_MAC"
LAB_WINLAB_MARKER_TAG="mm-pve-tools-lab-restore"
# IP estático da placa marcada da VM Windows na VLAN de restore (mesma rede do gateway)
LAB_WINLAB_IP="REPLACE_WITH_WINLAB_RESTORE_VLAN_IP"
# base64 de uma PASTA dentro de uma partição do backup, ex.
# /drive-sata1.img.fidx/part/2/<pasta> (a partição inteira não é publicada)
LAB_RESTORE_PATH_B64="REPLACE_WITH_BASE64_FILE_RESTORE_PATH"
# Arquivos deduplicados grandes (dezenas de MiB) ainda chegam com conteúdo
# errado pelo ntfs-3g + plugin de dedup; a prova usa uma pasta de arquivos
# deduplicados pequenos até esse bug ser corrigido no pve-file-restore-ntfs3g.
# sha256sum dos arquivos com caminhos relativos a essa pasta
LAB_MANIFEST_FILE="/caminho/local/para/manifest-da-pasta.sha256"

LAB_RENUMBER1_NODE="REPLACE_WITH_LAB_NODE_1"
LAB_RENUMBER1_STORAGES="REPLACE_WITH_STORAGE_A,REPLACE_WITH_STORAGE_B"
LAB_RENUMBER1_OLD_VMID="REPLACE_WITH_FREE_OLD_VMID"
LAB_RENUMBER1_NEW_VMID="REPLACE_WITH_FREE_NEW_VMID"
LAB_RENUMBER2_NODE="REPLACE_WITH_LAB_NODE_2"
LAB_RENUMBER2_STORAGES="REPLACE_WITH_STORAGE_C"
LAB_RENUMBER2_OLD_VMID="REPLACE_WITH_FREE_OLD_VMID"
LAB_RENUMBER2_NEW_VMID="REPLACE_WITH_FREE_NEW_VMID"

LAB_APT_SHA256_FILE="/caminho/local/para/SHA256SUMS"
LAB_APT_ORIGIN_PATTERN="MasterMind"
LAB_EVIDENCE_DIR="/caminho/fora/do/repositorio/pve-lab/evidence"
