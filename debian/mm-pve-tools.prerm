#!/bin/sh
# prerm do mm-pve-tools: na remoção, tira os patches do núcleo e os manifestos
# de módulos persistidos, deixando os pacotes PVE originais. Em upgrade
# (upgrade/failed-upgrade) não mexe.

set -e

case "$1" in
    remove|deconfigure)
        if [ -x /usr/lib/mm-pve-tools/apply-patches ]; then
            /usr/lib/mm-pve-tools/apply-patches --revert || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
