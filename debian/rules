#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	$(MAKE) js
	mkdir -p build/man
	pod2man --section=8 --name=mm-pve --center="MasterMind mm-pve-tools" \
		--release="mm-pve-tools $(shell dpkg-parsechangelog -SVersion)" \
		bin/mm-pve build/man/mm-pve.8
	pod2man --section=8 --name=gw-restore --center="MasterMind mm-gw-restore" \
		--release="mm-pve-tools $(shell dpkg-parsechangelog -SVersion)" \
		docs/gw-restore.pod build/man/gw-restore.8

override_dh_auto_test:
ifneq ($(filter nocheck,$(DEB_BUILD_OPTIONS)),)
	@echo "testes omitidos por DEB_BUILD_OPTIONS=nocheck"
else
	$(MAKE) test test-gateway
endif

override_dh_install:
	dh_install
	version='$(shell dpkg-parsechangelog -SVersion | sed -E 's/^[0-9]+://' | sed -E 's/-[^-]+$$//')'; \
	grep -rlIZF '@MM_PVE_VERSION@' debian/mm-pve-tools debian/mm-gw-restore \
	    | xargs -0 -r sed -i "s/@MM_PVE_VERSION@/$$version/g"

override_dh_fixperms:
	dh_fixperms
	chmod 0755 debian/mm-pve-tools/usr/sbin/mm-pve
	chmod 0755 debian/mm-pve-tools/usr/lib/mm-pve-tools/apply-patches
	chmod 0755 debian/mm-gw-restore/usr/sbin/gw-restore
