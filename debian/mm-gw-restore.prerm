#!/bin/sh
# prerm do mm-gw-restore: na remoção, revoga sessões restantes, remove o
# include do Samba e descarrega a tabela nft.

set -e
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

case "$1" in
    remove|deconfigure)
        if command -v gw-restore >/dev/null 2>&1; then
            gw-restore revoke --all >/dev/null 2>&1 || true
            gw-restore gc --boot >/dev/null 2>&1 || true
        fi
        if [ -f /etc/samba/smb.conf ]; then
            sed -i -e '/^[[:space:]]*include[[:space:]]*=[[:space:]]*\/etc\/samba\/gw-restore\.conf/d' \
                /etc/samba/smb.conf || true
        fi
        if command -v nft >/dev/null 2>&1; then
            nft delete table inet gw_restore >/dev/null 2>&1 || true
        fi
        if command -v systemctl >/dev/null 2>&1; then
            systemctl disable gw-restore-nft.service gw-restore-gc-boot.service >/dev/null 2>&1 || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
