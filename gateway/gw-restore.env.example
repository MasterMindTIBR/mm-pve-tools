# Credencial PBS do gateway — copie para /etc/gw-restore/pbs.env (0600, root).
# Um único servidor PBS; o datastore vem do payload e precisa estar na allowlist.
PBS_SERVER=pbs-host:8007
PBS_USER=gw-restore@pbs!gateway
PBS_PASSWORD=coloque-aqui-o-token-ou-senha
PBS_FINGERPRINT=AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD
PBS_DATASTORES=datastore
# Backups criptografados: keyfile 0600 em /etc/gw-restore/keys/<datastore>.key
#PBS_KEYFILE=/etc/gw-restore/keys/datastore.key
# Interface trunk VLAN-aware do gateway.
TRUNK=ens20
