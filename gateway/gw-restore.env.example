# Credencial PBS do gateway — copie para /etc/gw-restore/pbs.env (0600, root).
# Token SOMENTE LEITURA (DatastoreReader) no datastore/namespace de backup.
PBS_REPOSITORY=gw-restore@pbs@pbs-host!8007:datastore
PBS_FINGERPRINT=AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD
# Backups criptografados: keyfile 0600 em /etc/gw-restore/keys/<storage>.enc
#PBS_KEYFILE=/etc/gw-restore/keys/meudatastore.enc
