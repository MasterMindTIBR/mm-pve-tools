    "audit_log": "/var/log/gw-restore/audit.log",
    "sessions_root": "/srv/gw-restore/sessions",
    "mounts_root": "/srv/gw-restore/mounts",
    "samba_d_dir": "/etc/samba/gw-restore.d",
