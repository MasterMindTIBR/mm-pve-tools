# CLI
# --------------------------------------------------------------------------
def _global_lock(ctx):
    os.makedirs(os.path.dirname(ctx["lock_file"]), exist_ok=True)
    handle = open(ctx["lock_file"], "a")
    fcntl.flock(handle, fcntl.LOCK_EX)
    return handle


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="gw-restore",
        description="Publica pastas de backups PBS via Samba, por sessão.")
    parser.add_argument("--version", action="version",
                        version="gw-restore " + VERSION)
    sub = parser.add_subparsers(dest="cmd")

    sub.add_parser("publish", help="publica uma pasta (JSON no stdin)")
    revoke = sub.add_parser("revoke", help="revoga uma sessão")
    revoke.add_argument("session", nargs="?", default=None)
    revoke.add_argument("--all", action="store_true")
    lst = sub.add_parser("list", help="lista sessões ativas")
    lst.add_argument("--json", action="store_true")
    gc = sub.add_parser("gc", help="revoga sessões vencidas")
    gc.add_argument("--boot", action="store_true",
                    help="limpeza pós-reboot (sem maps)")
    sc = sub.add_parser("selfcheck", help="verifica pré-requisitos")
    sc.add_argument("--json", action="store_true")

    args = parser.parse_args(argv)
    if args.cmd is None:
        parser.print_help()
        return 2

    gw = GwRestore()
    lock = None
    try:
        if args.cmd == "publish":
            try:
                payload = json.load(sys.stdin)
            except ValueError as exc:
                print("gw-restore: JSON inválido no stdin: %s" % exc,
                      file=sys.stderr)
                return 1
            try:
                result = gw.publish(payload)
            except CrashInjected:
                return 70
            except GwError as exc:
                if exc.code in ("busy", "session_gone") and isinstance(payload, dict):
                    error = validate_contract("publish_error", {
                        "contract": CONTRACT_VERSION,
                        "request_id": payload.get("request_id", "invalid"),
                        "error": exc.code,
                        "message": str(exc),
                    })
                    print(json.dumps(error, ensure_ascii=False, sort_keys=True),
                          file=sys.stderr)
                else:
                    print("gw-restore: %s" % exc, file=sys.stderr)
                return 1
            json.dump(result, sys.stdout, indent=1, sort_keys=True)
            sys.stdout.write("\n")
            return 0
        if args.cmd == "revoke":
            lock = _global_lock(gw.ctx)
            if args.all:
                for session_id in sorted(gw._load_states()):
                    gw.revoke(session_id)
                return 0
            if not args.session:
                print("gw-restore: informe o id da sessão "
                      "(veja: gw-restore list --json)", file=sys.stderr)
                return 2
            try:
                validate_contract("revoke_request", {
                    "contract": CONTRACT_VERSION,
                    "id": args.session,
                })
                result = gw.revoke(args.session)
            except GwError as exc:
                print("gw-restore: %s" % exc, file=sys.stderr)
                return 1
            json.dump(result, sys.stdout, indent=1, sort_keys=True)
            sys.stdout.write("\n")
            return 0
        if args.cmd == "list":
            print(gw.list(as_json=args.json))
            return 0
        if args.cmd == "gc":
            lock = _global_lock(gw.ctx)
            result = gw.gc(boot=args.boot)
            print(json.dumps(result, indent=1, sort_keys=True))
            return 0
        if args.cmd == "selfcheck":
            print(gw.selfcheck(as_json=args.json))
            return 0
    finally:
        if lock:
            lock.close()
    return 2


if __name__ == "__main__":
    sys.exit(main())
