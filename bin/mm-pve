#!/usr/bin/perl
# mm-pve — CLI da MasterMind para o PVE (root).
# A lógica dos módulos fica aqui; API e GUI só chamam esta CLI (plano D4).

use strict;
use warnings;
use FindBin;
use Getopt::Long qw(:config no_auto_abbrev no_ignore_case bundling);
use JSON::PP qw(decode_json);

BEGIN {
    # Desenvolvimento: rodando direto do repo (bin/ + lib/ + perl/)
    my $dev = "$FindBin::Bin/..";
    if (-d "$dev/lib/MMPve") {
        unshift @INC, "$dev/lib", "$dev/perl";
    }
}

use MMPve::Core::Config;
use MMPve::Core::Apply;
use MMPve::Core::Status;
use MMPve::Core::Patch;
use MMPve::Core::Modules;
use MMPve::Core::Util qw(json_encode);

our $VERSION = '@MM_PVE_VERSION@';

my $JSON = 0;

sub out_json {
    my ($d) = @_;
    binmode(STDOUT);
    print json_encode($d, pretty => 1), "\n";
}

sub usage {
    print <<'EOF';
mm-pve - MasterMind tools for Proxmox VE

usage: mm-pve [--json] <command> [options]

core commands:
  version                      show the mm-pve-tools version
  config get                   show the config (with digest)
  config set --file <file>     replace the config (--stdin reads stdin)
                               [--digest <sha256:...>] require a concurrent revision
  config set-module <name> --enable|--disable
  apply [--no-patches] [--no-reload] apply patches and modules on this node
  status                       show node diagnostics
  patch check|apply|revert     patch the pve-manager and modules
  patch reload-verify          reload and verify pending targets
  help                         show this help

module commands:
  renumber ...                 change a VMID (mm-pve renumber --help)
  restore ...                  publish a folder (mm-pve restore --help)
  branding ...                 visual identity (mm-pve branding --help)
  ui ...                       console defaults and popup (mm-pve ui --help)
  updates ...                  update nodes (mm-pve updates --help)
  poollimits ...               per-pool limits (mm-pve poollimits --help)

global: --json  JSON output
EOF
}

sub fail {
    my ($msg, $hint) = @_;
    print STDERR "ERROR: $msg\n";
    print STDERR "Continue with: $hint\n" if $hint;
    exit 1;
}

sub cmd_config_get {
    my ($cfg, $digest, $absent) = MMPve::Core::Config->load;
    if ($JSON) {
        out_json({
            config => $cfg,
            digest => $digest,
            absent => $absent ? 1 : 0,
        });
    } else {
        print json_encode($cfg, pretty => 1);
        print "digest: " . ($digest // '(missing: defaults)') . "\n";
    }
    return 0;
}

sub cmd_config_set {
    my @argv = @_;
    my ($file, $stdin, $digest);
    local @ARGV = @argv;
    GetOptions(
        'file=s'   => \$file,
        'stdin'    => \$stdin,
        'digest=s' => \$digest,
    ) or return 2;
    my $raw;
    if ($stdin) {
        local $/;
        $raw = <STDIN>;
    } elsif ($file) {
        open(my $fh, '<', $file) or fail "could not open $file: $!";
        local $/;
        $raw = <$fh>;
        close $fh;
    } else {
        fail 'config set requires --file <file.json> or --stdin';
    }
    my $data = eval { decode_json($raw) };
    fail "invalid JSON: $@" if $@;
    my ($saved, $dig) = eval { MMPve::Core::Config->save($data, defined $digest ? (digest => $digest) : ()) };
    fail(($@ =~ /^DIGEST_MISMATCH/ ? "another writer saved first; read the config again ($@)" : $@),
        'mm-pve config get') if $@;
    print "config saved (revision $saved->{revision})\ndigest: $dig\n" unless $JSON;
    out_json({ revision => $saved->{revision}, digest => $dig }) if $JSON;
    return 0;
}

sub cmd_config_set_module {
    my @argv = @_;
    my ($enable, $disable);
    local @ARGV = @argv;
    GetOptions('enable' => \$enable, 'disable' => \$disable) or return 2;
    my $name = shift @ARGV;
    fail 'usage: config set-module <renumber|restore|branding|ui|updates> --enable|--disable' unless $name;
    my ($cfg, $digest) = MMPve::Core::Config->load;
    my %known = map { $_ => 1 } MMPve::Core::Modules->names;
    fail "unknown module '$name' (known: " . join(', ', sort keys %known) . ')'
        unless $known{$name};
    fail 'use --enable OR --disable' unless ($enable ? 1 : 0) + ($disable ? 1 : 0) == 1;
    $cfg->{modules}{$name} = $enable ? 1 : 0;
    my ($saved) = eval { MMPve::Core::Config->save($cfg, digest => $digest) };
    fail $@, 'mm-pve apply' if $@;
    print "module $name " . ($enable ? 'enabled' : 'disabled') . " (revision $saved->{revision}); run mm-pve apply\n";
    return 0;
}

sub cmd_apply {
    my @argv = @_;
    my ($nopatch, $noreload);
    local @ARGV = @argv;
    GetOptions(
        'no-patches' => \$nopatch,
        'no-reload'  => \$noreload,
    ) or return 2;
    my %opts = $nopatch ? (patches => 0) : ();
    $opts{no_reload} = 1 if $noreload;
    my $res = eval { MMPve::Core::Apply->apply_all(%opts) };
    fail $@, 'mm-pve status' if $@;
    if ($JSON) {
        out_json($res);
    } else {
        print "apply revision $res->{revision}: " . ($res->{ok} ? 'OK' : 'WITH ERRORS') . "\n";
        for my $n (sort keys %{ $res->{modules} // {} }) {
            my $m = $res->{modules}{$n};
            printf "  %-9s %-7s %s\n", $n, ($m->{enabled} ? 'enabled' : 'disabled'),
                ($m->{ok} ? 'ok' : "ERROR: " . ($m->{error} // '?'));
        }
        my $p = $res->{patches};
        if ($p) {
            for my $t (sort keys %{ $p->{targets} // {} }) {
                printf "  patch %-10s %s\n", $t, $p->{targets}{$t}{status};
            }
        }
    }
    return $res->{ok} ? 0 : 1;
}

sub cmd_status {
    my $s = eval { MMPve::Core::Status->collect };
    fail $@ if $@;
    if ($JSON) {
        out_json($s);
    } else {
        print "node:            $s->{node}\n";
        print "mm-pve-tools:    $s->{package_version}\n";
        print "pve:             $s->{pve_version}\n";
        my $ap = $s->{applied};
        print "state:            $ap->{state} (applied r" . ($ap->{applied_revision} // '-') . ', config r' . ($ap->{config_revision} // '-') . ")\n";
        for my $failure (@{ $ap->{failures} // [] }) {
            my $target = $failure->{target} // $failure->{module} // 'apply';
            my $error = $failure->{error} // 'unknown failure';
            $error =~ s/[\r\n]+/ /g;
            print "failure $target: $error\n";
        }
        my $pc = $ap->{patches} // {};
        for my $target (sort keys %{$pc}) {
            my $p = $pc->{$target} // {};
            my $extra = join(' ', grep { defined && length } (
                (defined($p->{module}) ? "module=$p->{module}" : ()),
                (defined($p->{owner}) ? "owner=$p->{owner}" : ()),
            ));
            print "patch $target: " . ($p->{status} // '?')
                . (length($extra) ? " [$extra]" : '') . "\n";
        }
        my $nt = $s->{ntfs3g};
        print "ntfs3g:          " . (defined $nt->{ok} ? ($nt->{ok} ? 'OK' : 'FAILED: ' . ($nt->{error} // '')) : '(skipped)') . "\n";
        my $ui = $s->{modules}{ui}{check} // {};
        print "ui bundles:      " . ($ui->{ok} ? 'OK' : ($ui->{note} // 'FAILED')) . "\n";
    }
    return 0;
}

sub cmd_patch {
    my @argv = @_;
    my $sub = shift @argv // '';
    if ($sub eq 'check') {
        my $c = MMPve::Core::Patch->check;
        out_json($c) if $JSON;
        for my $k (sort keys %{$c}) {
            next if $JSON;
            my $error = $c->{$k}{error};
            $error =~ s/[\r\n]+/ /g if defined($error);
            print "$k: $c->{$k}{status}" . (defined($error) ? " ($error)" : '') . "\n";
        }
        return 0;
    }
    if ($sub eq 'apply') {
        my $r = MMPve::Core::Patch->apply;
        out_json($r) if $JSON;
        return $r->{ok} ? 0 : 1;
    }
    if ($sub eq 'revert') {
        my $r = MMPve::Core::Patch->revert;
        out_json($r) if $JSON;
        return 0;
    }
    if ($sub eq 'clear-failures') {
        my $r = MMPve::Core::Patch->clear_failures;
        out_json($r) if $JSON;
        print 'cleared previous failures: ' . (join(', ', @{ $r->{cleared} }) || 'none') . "\n" unless $JSON;
        return 0;
    }
    if ($sub eq 'reload-verify') {
        my $fallback;
        local @ARGV = @argv;
        GetOptions('fallback-daemons=s' => \$fallback) or return 2;
        my @daemons = defined($fallback) && length($fallback) ? split(/,/, $fallback) : ();
        my $r = MMPve::Core::Patch->reload_verify(fallback_daemons => \@daemons);
        out_json($r) if $JSON;
        return $r->{ok} ? 0 : 1;
    }
    print STDERR "usage: mm-pve patch check|apply|revert|clear-failures|reload-verify\n";
    return 2;
}

# ---------------------------------------------------------------- main

my @argv = @ARGV;
my $cmd = shift @argv // 'help';

# --json pode vir antes ou depois do comando
if ($cmd eq '--json') {
    $JSON = 1;
    $cmd = shift @argv // 'help';
}
@argv = grep { $_ ne '--json' ? 1 : do { $JSON = 1; 0 } } @argv;

my %MODULE_CMD = (
    renumber => 'MMPve::Module::Renumber',
    restore  => 'MMPve::Module::Restore',
    branding => 'MMPve::Module::Branding',
    ui       => 'MMPve::Module::Ui',
    updates  => 'MMPve::Module::Updates',
    poollimits => 'MMPve::Module::Poollimits',
);

my $rc;
if ($cmd eq 'help' || $cmd eq '--help' || $cmd eq '-h') {
    usage();
    $rc = 0;
} elsif ($cmd eq 'version') {
    out_json({ version => $VERSION }) if $JSON;
    print "mm-pve-tools $VERSION\n" unless $JSON;
    $rc = 0;
} elsif ($cmd eq 'config') {
    my $sub = shift @argv // 'get';
    if ($sub eq 'get') {
        $rc = cmd_config_get();
    } elsif ($sub eq 'set') {
        $rc = cmd_config_set(@argv);
    } elsif ($sub eq 'set-module') {
        $rc = cmd_config_set_module(@argv);
    } else {
        print STDERR "usage: mm-pve config get|set|set-module\n";
        $rc = 2;
    }
} elsif ($cmd eq 'apply') {
    $rc = cmd_apply(@argv);
} elsif ($cmd eq 'status') {
    $rc = cmd_status(@argv);
} elsif ($cmd eq 'patch') {
    $rc = cmd_patch(@argv);
} elsif ($MODULE_CMD{$cmd}) {
    my $cls = $MODULE_CMD{$cmd};
    eval "require $cls" or do { print STDERR "$cls unavailable: $@\n"; exit 1 };
    $rc = $cls->cli(\@argv);
} else {
    print STDERR "unknown command '$cmd'\n";
    usage();
    $rc = 2;
}
exit($rc // 0);

__END__
=encoding UTF-8

=head1 NAME

mm-pve - CLI MasterMind para Proxmox VE

=head1 SYNOPSIS

B<mm-pve> [B<--json>] I<comando> [opções]

Comandos: version, config (get|set|set-module), apply, status, patch
(check|apply|revert) e os subcomandos dos módulos: renumber, restore,
branding, ui, updates.

=head1 DESCRIPTION

Toda a lógica dos módulos mm-pve-tools vive nesta CLI; a API (pvedaemon) e a
GUI chamam a CLI. Tarefa interrompida imprime o comando exato para continuar
(--resume/--rollback).

=cut
